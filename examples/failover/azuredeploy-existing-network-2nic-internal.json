{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "3.3.0.0",
  "parameters": {
    "templateBaseUrl": {
      "defaultValue": "https://raw.githubusercontent.com/cmillerbigbeard/f5-azure-arm-templates-v2/",
      "metadata": {
        "description": "The publicly accessible URL where the linked ARM templates are located."
      },
      "type": "string"
    },
    "allowUsageAnalytics": {
      "defaultValue": true,
      "metadata": {
        "description": "This deployment can send anonymous statistics to F5 to help us determine how to improve our solutions. If you select **false** statistics are not sent."
      },
      "type": "bool"
    },
    "artifactLocation": {
      "defaultValue": "azure-failover-17.5/examples/",
      "metadata": {
        "description": "The directory, relative to the templateBaseUrl, where the modules folder is located."
      },
      "type": "string"
    },
    "uniqueString": {
      "metadata": {
        "description": "REQUIRED - A prefix that will be used to name template resources. Because some resources require globally unique names, we recommend using a unique value."
      },
      "type": "string"
    },
    "bigIpHostname01": {
      "defaultValue": "failover01.local",
      "metadata": {
        "description": "Supply the hostname you would like to use for the BIG-IP instance. The hostname must contain fewer than 63 characters."
      },
      "type": "string"
    },
    "bigIpHostname02": {
      "defaultValue": "failover02.local",
      "metadata": {
        "description": "Supply the hostname you would like to use for the BIG-IP instance. The hostname must contain fewer than 63 characters."
      },
      "type": "string"
    },
    "bigIpImage": {
      "defaultValue": "f5-networks:f5-big-ip-best:f5-big-best-plus-hourly-25mbps:17.5.109174",
      "metadata": {
        "description": "2 formats accepted. URN of the image to use in Azure marketplace or id of custom image. Example URN value: f5-networks:f5-big-ip-byol:f5-big-all-2slot-byol:17.1.100002. You can find the URNs of F5 marketplace images in the README for this template or by running the command: az vm image list --output yaml --publisher f5-networks --all. See https://clouddocs.f5.com/cloud/public/v1/azure/Azure_download.html for information on creating custom BIG-IP image."
      },
      "type": "string"
    },
    "bigIpInstanceType": {
      "defaultValue": "Standard_D8s_v4",
      "metadata": {
        "description": "Enter valid instance type."
      },
      "type": "string"
    },
    "bigIpLicenseKey01": {
      "defaultValue": "",
      "metadata": {
        "description": "Supply the F5 BYOL license key for BIG-IP instance 01. Leave this parameter blank if deploying the PAYG solution."
      },
      "type": "string"
    },
    "bigIpLicenseKey02": {
      "defaultValue": "",
      "metadata": {
        "description": "Supply the F5 BYOL license key for BIG-IP instance 02. Leave this parameter blank if deploying the PAYG solution."
      },
      "type": "string"
    },
    "bigIpPasswordSecretId": {
      "defaultValue": "",
      "metadata": {
        "description": "The full URL of the secretId where the BIG-IP password is stored, including KeyVault Name. For example: https://yourvaultname.vault.azure.net/secrets/yoursecretid. If not provided, the solution will create a secret with the value provided for the bigIpPasswordSecretValue parameter. This parameter is REQUIRED if bigIpPasswordSecretValue is empty."
      },
      "type": "string"
    },
    "bigIpPasswordSecretValue": {
      "defaultValue": "",
      "metadata": {
        "description": "The value to use for the BIG-IP admin password, if a value is not provided for the bigIpPasswordSecretId parameter. This parameter is REQUIRED if bigIpPasswordSecretId is empty."
      },
      "type": "securestring"
    },
    "sshKey": {
      "metadata": {
        "description": "REQUIRED - Supply the public key that will be used for SSH authentication to the BIG-IP and application virtual machines."
      },
      "type": "string"
    },
    "restrictedSrcAddressMgmt": {
      "metadata": {
        "description": "REQUIRED - Restricts management access (ports 22 and 443) to a specific network or address. Enter a private address range in CIDR notation, such as your management or bastion-free jump network."
      },
      "type": "string"
    },
    "bigIpMgmtSubnetId": {
      "metadata": {
        "description": "REQUIRED - Supply the Azure resource ID of the management subnet where BIG-IP VE instances will be deployed."
      },
      "type": "string"
    },
    "bigIpInternalSubnetId": {
      "metadata": {
        "description": "REQUIRED - Supply the Azure resource ID of the internal (data) subnet where BIG-IP VE instances will be deployed."
      },
      "type": "string"
    },
    "bigIpInternalSelfIp01": {
      "defaultValue": "10.0.1.11",
      "metadata": {
        "description": "Internal (data) Private IP Address for BIGIP Instance 01. IP address parameter must be in the form x.x.x.x."
      },
      "type": "string"
    },
    "bigIpInternalSelfIp02": {
      "defaultValue": "10.0.1.12",
      "metadata": {
        "description": "Internal (data) Private IP Address for BIGIP Instance 02. IP address parameter must be in the form x.x.x.x."
      },
      "type": "string"
    },
    "bigIpMgmtAddress01": {
      "defaultValue": "10.0.0.11",
      "metadata": {
        "description": "Management Private IP Address for BIGIP Instance 01. IP address parameter must be in the form x.x.x.x."
      },
      "type": "string"
    },
    "bigIpMgmtAddress02": {
      "defaultValue": "10.0.0.12",
      "metadata": {
        "description": "Management Private IP Address for BIGIP Instance 02. IP address parameter must be in the form x.x.x.x."
      },
      "type": "string"
    },
    "bigIpRuntimeInitConfig01": {
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Supply a URL to the bigip-runtime-init configuration file in YAML or JSON format, or an escaped JSON string. Leave blank to auto-select the BYOL config when bigIpLicenseKey01 is set, otherwise the PAYG config (3nic or 2nic per numNics, without the example app)."
      },
      "type": "string"
    },
    "bigIpRuntimeInitConfig02": {
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Supply a URL to the bigip-runtime-init configuration file in YAML or JSON format, or an escaped JSON string. Leave blank to auto-select the BYOL config when bigIpLicenseKey02 is set, otherwise the PAYG config (3nic or 2nic per numNics, without the example app)."
      },
      "type": "string"
    },
    "bigIpRuntimeInitPackageUrl": {
      "defaultValue": "https://cdn.f5.com/product/cloudsolutions/f5-bigip-runtime-init/v2.0.3/dist/f5-bigip-runtime-init-2.0.3-1.gz.run",
      "metadata": {
        "description": "URL for BIG-IP Runtime Init package"
      },
      "type": "string"
    },
    "cfeStorageAccountName": {
      "defaultValue": "",
      "metadata": {
        "description": "Supply a unique name for a CFE storage account created and used by Cloud Failover Extension."
      },
      "type": "string"
    },
    "cfeTag": {
      "defaultValue": "bigip_high_availability_solution",
      "metadata": {
        "description": "Cloud Failover deployment tag value."
      },
      "type": "string"
    },
    "useAvailabilityZones": {
      "defaultValue": false,
      "metadata": {
        "description": "This deployment can deploy resources into Azure Availability Zones (if the region supports it).  If that is not desired the input should be set false. If the region does not support availability zones the input should be set to false."
      },
      "type": "bool"
    },
    "bigIpUserAssignManagedIdentity": {
      "defaultValue": "",
      "metadata": {
        "description": "Enter user assigned management identity ID to be associated to virtual machine. Leave default if not used."
      },
      "type": "string"
    },
    "tagValues": {
      "defaultValue": {
        "application": "f5demoapp",
        "cost": "f5cost",
        "environment": "f5env",
        "group": "f5group",
        "owner": "f5owner"
      },
      "metadata": {
        "description": "Default key/value resource tags will be added to the resources in this deployment, if you would like the values to be unique adjust them as needed for each key."
      },
      "type": "object"
    }
  },
  "variables": {
    "runtimeInitConfig01": "[if(empty(parameters('bigIpRuntimeInitConfig01')), concat(parameters('templateBaseUrl'), parameters('artifactLocation'), 'failover/bigip-configurations/runtime-init-conf-', '2', 'nic-', if(empty(parameters('bigIpLicenseKey01')), 'payg', 'byol'), '-instance01.yaml'), parameters('bigIpRuntimeInitConfig01'))]",
    "runtimeInitConfig02": "[if(empty(parameters('bigIpRuntimeInitConfig02')), concat(parameters('templateBaseUrl'), parameters('artifactLocation'), 'failover/bigip-configurations/runtime-init-conf-', '2', 'nic-', if(empty(parameters('bigIpLicenseKey02')), 'payg', 'byol'), '-instance02.yaml'), parameters('bigIpRuntimeInitConfig02'))]",
    "contentVersion": "[deployment().properties.template.contentVersion]",
    "uniqueString": "[toLower(parameters('uniqueString'))]",
    "adminUsername": "[string('azureuser')]",
    "solutionType": "failover",
    "createManagedIdentity": "[empty(parameters('bigIpUserAssignManagedIdentity'))]",
    "createSecret": "[and(not(empty(parameters('bigIpPasswordSecretValue'))), empty(parameters('bigIpPasswordSecretId')))]",
    "customAssignableScopes": [],
    "customRolePermissions": [],
    "roleDescription": "Role created by failover deployment",
    "roleName": "[concat(variables('uniqueString'), '-bigip-high-availability-role')]",
    "keyVaultPermissionsKeys": [
      "list",
      "get"
    ],
    "keyVaultPermissionsSecrets": [
      "list",
      "get"
    ],
    "userAssignedIdentityName": "[concat(variables('uniqueString'), '-bigip-user-identity')]",
    "externalLoadBalancerName": "None",
    "internalLoadBalancerName": "None",
    "loadBalancerRulePorts": [],
    "mgmtNsgRulesArray": [
      {
        "destinationPortRanges": [
          "22",
          "443"
        ],
        "sourceAddressPrefix": "[parameters('restrictedSrcAddressMgmt')]",
        "protocol": "Tcp"
      }
    ],
    "mgmtSecurityGroup": "[variables('mgmtNsgRulesArray')]",
    "cfeStorageAccountName": "[if(not(empty(parameters('cfeStorageAccountName'))), parameters('cfeStorageAccountName'), concat(parameters('uniqueString'), 'stcfe'))]",
    "vmName01": "[concat(variables('uniqueString'), '-bigip-vm-01')]",
    "vmName02": "[concat(variables('uniqueString'), '-bigip-vm-02')]",
    "internalNsgRulesArray": [],
    "internalSecurityGroup": "[variables('internalNsgRulesArray')]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "condition": "[variables('createManagedIdentity')]",
      "name": "accessTemplate",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('templateBaseUrl'), parameters('artifactLocation'), 'modules/access/access.json')]",
          "contentVersion": "[variables('contentVersion')]"
        },
        "parameters": {
          "solutionType": {
            "value": "[variables('solutionType')]"
          },
          "customAssignableScopes": {
            "value": "[variables('customAssignableScopes')]"
          },
          "roleDescription": {
            "value": "[variables('roleDescription')]"
          },
          "roleName": {
            "value": "[variables('roleName')]"
          },
          "customRolePermissions": {
            "value": "[variables('customRolePermissions')]"
          },
          "keyVaultPermissionsKeys": {
            "value": "[variables('keyVaultPermissionsKeys')]"
          },
          "keyVaultPermissionsSecrets": {
            "value": "[variables('keyVaultPermissionsSecrets')]"
          },
          "secretId": {
            "value": "[parameters('bigIpPasswordSecretId')]"
          },
          "secretValue": {
            "value": "[parameters('bigIpPasswordSecretValue')]"
          },
          "uniqueString": {
            "value": "[variables('uniqueString')]"
          },
          "userAssignedIdentityName": {
            "value": "[variables('userAssignedIdentityName')]"
          },
          "tagValues": {
            "value": "[parameters('tagValues')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "dagTemplate",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('templateBaseUrl'), parameters('artifactLocation'), 'modules/dag/dag.json')]",
          "contentVersion": "[variables('contentVersion')]"
        },
        "parameters": {
          "uniqueString": {
            "value": "[variables('uniqueString')]"
          },
          "externalLoadBalancerName": {
            "value": "[variables('externalLoadBalancerName')]"
          },
          "internalLoadBalancerName": {
            "value": "[variables('internalLoadBalancerName')]"
          },
          "internalSubnetId": {
            "value": ""
          },
          "loadBalancerRulePorts": {
            "value": "[variables('loadBalancerRulePorts')]"
          },
          "nsg0": {
            "value": "[variables('mgmtSecurityGroup')]"
          },
          "nsg1": {
            "value": "[variables('internalSecurityGroup')]"
          },
          "numberPublicExternalIpAddresses": {
            "value": 0
          },
          "numberPublicMgmtIpAddresses": {
            "value": 0
          },
          "tagValues": {
            "value": "[parameters('tagValues')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "bigIpTemplate01",
      "dependsOn": [
        "accessTemplate",
        "dagTemplate"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('templateBaseUrl'), parameters('artifactLocation'), 'modules/bigip-standalone/bigip.json')]",
          "contentVersion": "[variables('contentVersion')]"
        },
        "parameters": {
          "adminUsername": {
            "value": "[variables('adminUsername')]"
          },
          "allowUsageAnalytics": {
            "value": "[parameters('allowUsageAnalytics')]"
          },
          "hostname": {
            "value": "[parameters('bigIpHostname01')]"
          },
          "licenseKey": {
            "value": "[parameters('bigIpLicenseKey01')]"
          },
          "bigIpPeerAddr": {
            "value": ""
          },
          "bigIpPeerHostname": {
            "value": "[parameters('bigIpHostname02')]"
          },
          "cfeStorageAccountName": {
            "value": "[variables('cfeStorageAccountName')]"
          },
          "cfeTag": {
            "value": "[parameters('cfeTag')]"
          },
          "image": {
            "value": "[parameters('bigIpImage')]"
          },
          "instanceType": {
            "value": "[parameters('bigIpInstanceType')]"
          },
          "mgmtSubnetId": {
            "value": "[parameters('bigIpMgmtSubnetId')]"
          },
          "mgmtNsgID": {
            "value": "[reference('dagTemplate').outputs.nsg0Id.value]"
          },
          "mgmtPublicIpId": {
            "value": ""
          },
          "mgmtSelfIp": {
            "value": "[parameters('bigIpMgmtAddress01')]"
          },
          "nic1SubnetId": {
            "value": "[parameters('bigIpInternalSubnetId')]"
          },
          "nic1NsgId": {
            "value": "[reference('dagTemplate').outputs.nsg1Id.value]"
          },
          "nic1PrimaryPublicId": {
            "value": ""
          },
          "nic1SelfIp": {
            "value": "[parameters('bigIpInternalSelfIp01')]"
          },
          "nic1ServiceIPs": {
            "value": []
          },
          "nic2SubnetId": {
            "value": ""
          },
          "nic2NsgId": {
            "value": ""
          },
          "nic2PrimaryPublicId": {
            "value": ""
          },
          "nic2SelfIp": {
            "value": ""
          },
          "nic2ServiceIPs": {
            "value": []
          },
          "roleDefinitionId": {
            "value": ""
          },
          "bigIpRuntimeInitPackageUrl": {
            "value": "[parameters('bigIpRuntimeInitPackageUrl')]"
          },
          "bigIpRuntimeInitConfig": {
            "value": "[variables('runtimeInitConfig01')]"
          },
          "secretId": {
            "value": "[if(variables('createManagedIdentity'), reference('accessTemplate').outputs.secretId.value, parameters('bigIpPasswordSecretId'))]"
          },
          "sshKey": {
            "value": "[parameters('sshKey')]"
          },
          "tagValues": {
            "value": "[parameters('tagValues')]"
          },
          "uniqueString": {
            "value": "[concat(variables('uniqueString'), '01')]"
          },
          "userAssignManagedIdentity": {
            "value": "[if(not(variables('createManagedIdentity')), parameters('bigIpUserAssignManagedIdentity'), reference('accessTemplate').outputs.userAssignedIdentityId.value)]"
          },
          "vmName": {
            "value": "[variables('vmName01')]"
          },
          "zone": {
            "value": "[if(parameters('useAvailabilityZones'), '1', '')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "bigIpTemplate02",
      "dependsOn": [
        "accessTemplate",
        "dagTemplate"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('templateBaseUrl'), parameters('artifactLocation'), 'modules/bigip-standalone/bigip.json')]",
          "contentVersion": "[variables('contentVersion')]"
        },
        "parameters": {
          "adminUsername": {
            "value": "[variables('adminUsername')]"
          },
          "allowUsageAnalytics": {
            "value": "[parameters('allowUsageAnalytics')]"
          },
          "hostname": {
            "value": "[parameters('bigIpHostname02')]"
          },
          "licenseKey": {
            "value": "[parameters('bigIpLicenseKey02')]"
          },
          "bigIpPeerAddr": {
            "value": "[parameters('bigIpInternalSelfIp01')]"
          },
          "bigIpPeerHostname": {
            "value": "[parameters('bigIpHostname01')]"
          },
          "cfeStorageAccountName": {
            "value": ""
          },
          "cfeTag": {
            "value": "[parameters('cfeTag')]"
          },
          "image": {
            "value": "[parameters('bigIpImage')]"
          },
          "instanceType": {
            "value": "[parameters('bigIpInstanceType')]"
          },
          "mgmtSubnetId": {
            "value": "[parameters('bigIpMgmtSubnetId')]"
          },
          "mgmtNsgID": {
            "value": "[reference('dagTemplate').outputs.nsg0Id.value]"
          },
          "mgmtPublicIpId": {
            "value": ""
          },
          "mgmtSelfIp": {
            "value": "[parameters('bigIpMgmtAddress02')]"
          },
          "nic1SubnetId": {
            "value": "[parameters('bigIpInternalSubnetId')]"
          },
          "nic1NsgId": {
            "value": "[reference('dagTemplate').outputs.nsg1Id.value]"
          },
          "nic1PrimaryPublicId": {
            "value": ""
          },
          "nic1SelfIp": {
            "value": "[parameters('bigIpInternalSelfIp02')]"
          },
          "nic1ServiceIPs": {
            "value": []
          },
          "nic2SubnetId": {
            "value": ""
          },
          "nic2NsgId": {
            "value": ""
          },
          "nic2PrimaryPublicId": {
            "value": ""
          },
          "nic2SelfIp": {
            "value": ""
          },
          "nic2ServiceIPs": {
            "value": []
          },
          "roleDefinitionId": {
            "value": ""
          },
          "bigIpRuntimeInitPackageUrl": {
            "value": "[parameters('bigIpRuntimeInitPackageUrl')]"
          },
          "bigIpRuntimeInitConfig": {
            "value": "[variables('runtimeInitConfig02')]"
          },
          "secretId": {
            "value": "[if(variables('createManagedIdentity'), reference('accessTemplate').outputs.secretId.value, parameters('bigIpPasswordSecretId'))]"
          },
          "sshKey": {
            "value": "[parameters('sshKey')]"
          },
          "tagValues": {
            "value": "[parameters('tagValues')]"
          },
          "uniqueString": {
            "value": "[concat(variables('uniqueString'), '02')]"
          },
          "userAssignManagedIdentity": {
            "value": "[if(not(variables('createManagedIdentity')), parameters('bigIpUserAssignManagedIdentity'), reference('accessTemplate').outputs.userAssignedIdentityId.value)]"
          },
          "vmName": {
            "value": "[variables('vmName02')]"
          },
          "zone": {
            "value": "[if(parameters('useAvailabilityZones'), '2', '')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "bigIpInstance01VmId": {
      "type": "string",
      "value": "[reference('bigIpTemplate01').outputs.vmId.value]"
    },
    "bigIpInstance02VmId": {
      "type": "string",
      "value": "[reference('bigIpTemplate02').outputs.vmId.value]"
    },
    "bigIpInstance01ManagementPrivateIp": {
      "type": "string",
      "value": "[parameters('bigIpMgmtAddress01')]"
    },
    "bigIpInstance02ManagementPrivateIp": {
      "type": "string",
      "value": "[parameters('bigIpMgmtAddress02')]"
    },
    "bigIpInstance01ManagementPrivateUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('bigIpMgmtAddress01'), ':443/')]"
    },
    "bigIpInstance02ManagementPrivateUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('bigIpMgmtAddress02'), ':443/')]"
    },
    "bigIpSecretId": {
      "type": "string",
      "value": "[if(variables('createManagedIdentity'), reference('accessTemplate').outputs.secretId.value, parameters('bigIpPasswordSecretId'))]"
    }
  },
  "metadata": {
    "description": "BIG-IP HA pair, 2 NICs (management + internal), existing network, NO public IPs, NO VIP or example app."
  }
}
